<h1>Create account</h1>
<% if (error) { %>
  <p class="flash flash-error"><%= error %></p>
<% } %>
<form method="post" action="/auth/register">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <label>Display name <input name="displayName" required maxlength="120" /></label>
  <label>Username <input name="username" required maxlength="64" /></label>
  <label>Email <input name="email" type="email" required /></label>
  <label>Password <input name="password" type="password" required minlength="12" /></label>
  <button type="submit">Create account</button>
</form>
