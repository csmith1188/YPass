<h1>Sign in</h1>
<% if (error) { %>
  <p class="flash flash-error"><%= error %></p>
<% } %>

<% if (features.localAuth) { %>
  <form method="post" action="/auth/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="next" value="<%= next %>" />
    <label>Username <input name="username" required maxlength="64" /></label>
    <label>Password <input name="password" type="password" required /></label>
    <button type="submit">Sign in</button>
  </form>
  <p><a href="/auth/register">Create an account</a> · <a href="/auth/forgot">Forgot password</a></p>
<% } %>

<div class="auth-providers">
  <% if (features.formbarAuth) { %>
    <a class="button" href="/auth/formbar?next=<%= encodeURIComponent(next) %>">Continue with Formbar</a>
  <% } %>
  <% if (features.entraAuth) { %>
    <a class="button" href="/auth/entra?next=<%= encodeURIComponent(next) %>">Continue with Microsoft</a>
  <% } %>
</div>
