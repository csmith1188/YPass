<h1>Account</h1>
<p>Signed in as <%= currentUser.display_name %> (<%= currentUser.primary_email || 'no email' %>)</p>

<h2>Sign-in methods</h2>
<ul>
  <% identities.forEach((identity) => { %>
    <li>
      <%= identity.provider %> · <%= identity.subject %>
      <form class="inline" method="post" action="/account/unlink">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="identityId" value="<%= identity.id %>" />
        <% if (features.localAuth) { %>
          <input name="currentPassword" type="password" placeholder="Current password to confirm" />
        <% } %>
        <button type="submit">Unlink</button>
      </form>
    </li>
  <% }) %>
</ul>

<% if (features.formbarAuth) { %>
  <p><a href="/auth/formbar?link=1">Link Formbar</a></p>
<% } %>
<% if (features.entraAuth) { %>
  <p><a href="/auth/entra?link=1">Link Microsoft</a></p>
<% } %>

<% if (features.localAuth) { %>
  <h2>Change password</h2>
  <form method="post" action="/account/password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label>Current password <input name="currentPassword" type="password" required /></label>
    <label>New password <input name="newPassword" type="password" required minlength="12" /></label>
    <button type="submit">Update password</button>
  </form>
<% } %>
